# ============================================================
# .env.production.example
# Copy to .env on your server and fill in real values.
# NEVER commit the actual .env file.
# ============================================================

NODE_ENV=production
PORT=5000

# MongoDB Atlas connection string
# Rotate this if you've ever committed .env to a non-private repo
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/InteriorSoftware?appName=Cluster0

# JWT — generate a strong random secret:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=<64-char-random-hex>
JWT_EXPIRE=30d

# CORS — set to your production domain (no trailing slash)
CORS_ORIGIN=https://yourdomain.com

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

# Gemini AI
GEMINI_API_KEY=<your-gemini-key>

# Cloudinary
CLOUDINARY_CLOUD_NAME=<cloud-name>
CLOUDINARY_API_KEY=<api-key>
CLOUDINARY_API_SECRET=<api-secret>

# Web Push (VAPID)
VAPID_PUBLIC_KEY=<vapid-public-key>
VAPID_PRIVATE_KEY=<vapid-private-key>
VAPID_MAILTO=mailto:admin@yourdomain.com
